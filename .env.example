# DeepSeek API
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# JWT — 必填！必须改为随机长字符串（≥32 字符），否则服务拒绝启动。
# 生成命令: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE-WITH-A-RANDOM-SECRET-AT-LEAST-32-CHARS

# App
APP_NAME=R6AX-Learn
DEBUG=true
PORT=8000

# CORS — 默认同源（不跨域）。如需允许特定前端域名跨域（携带 cookie），
# 用逗号分隔列出完整 Origin，如: CORS_ORIGINS=https://app.example.com,https://dev.example.com
CORS_ORIGINS=
