# DeepSeek API
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# JWT - required! Must be replaced with a random string of at least 32
# characters, otherwise the service refuses to start.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE-WITH-A-RANDOM-SECRET-AT-LEAST-32-CHARS

# App
APP_NAME=R6AX-Learn
DEBUG=true
PORT=8000

# CORS - same-origin by default (no cross-origin). To allow specific frontend
# domains to make cross-origin requests (with cookies), list the full Origins
# separated by commas, e.g. CORS_ORIGINS=https://app.example.com,https://dev.example.com
CORS_ORIGINS=
